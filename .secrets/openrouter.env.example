# Copie para .secrets/openrouter.env e preencha:
#   cp .secrets/openrouter.env.example .secrets/openrouter.env
#   chmod 600 .secrets/openrouter.env
#
# Usada para transcrever audio (TRANSCRIBE_MODEL) e para o fallback de
# interpretacao por LLM. Sem a chave, o bot funciona so com texto e parser
# deterministico (AUDIO_ENABLED=false, LLM_FALLBACK=false).

OPENROUTER_API_KEY=

# Opcional: sobrescreve o modelo do frontmatter do agente.
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Opcional: modelo multimodal para transcrever audio (precisa aceitar input_audio).
# TRANSCRIBE_MODEL=google/gemini-2.5-flash
