# Copie para .secrets/agenda/telegram.env e preencha:
#   mkdir -p .secrets/agenda
#   cp .secrets/telegram.env.example .secrets/agenda/telegram.env
#   chmod 600 .secrets/agenda/telegram.env
#
# Um bot/token por agente (crie no @BotFather).

# Token do bot gerado no @BotFather.
TELEGRAM_BOT_TOKEN=

# IDs do Telegram autorizados a usar o bot (separados por virgula).
# Vazio = todos. Envie /id no chat do bot para descobrir o seu.
TELEGRAM_ALLOWED_USER_IDS=